{
  "mcpServers": {
    "atlas-backend": {
      "command": "node",
      "args": [
        "/Volumes/Local/dev/pj-personal/apps/atlas/tools/mcp-servers/api/dist/index.js"
      ],
      "env": {
        "ATLAS_BACKEND_PATH": "/Volumes/Local/dev/pj-personal/apps/atlas/apps/api",
        "ATLAS_PHP_CONTAINER": "atlas-php",
        "POSTGRES_HOST": "localhost",
        "POSTGRES_PORT": "5432",
        "POSTGRES_DB": "atlas",
        "POSTGRES_USER": "laravel",
        "POSTGRES_PASSWORD": "secret"
      }
    },
    "atlas-project": {
      "command": "node",
      "args": [
        "/Volumes/Local/dev/pj-personal/apps/atlas/tools/mcp-servers/project/dist/index.js"
      ],
      "env": {
        "ATLAS_API_URL": "http://localhost:8000/api/v1",
        "ATLAS_API_TOKEN": "replace-with-a-real-token",
        "ATLAS_TENANT_ID": ""
      }
    },
    "atlas-dashboard": {
      "command": "node",
      "args": [
        "/Volumes/Local/dev/pj-personal/apps/atlas/tools/mcp-servers/dashboard/dist/index.js"
      ],
      "env": {
        "ATLAS_DASHBOARD_PATH": "/Volumes/Local/dev/pj-personal/apps/atlas/apps/dashboard"
      }
    }
  }
}
