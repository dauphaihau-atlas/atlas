{
  "mcpServers": {
    "playwright": {
      "command": "npx",
      "args": [
        "@playwright/mcp@latest"
      ]
    },
    "atlas-api": {
      "command": "/path/to/node",
      "args": ["/path/to/atlas/mcp-servers/api/dist/index.js"],
      "env": {
        "ATLAS_BACKEND_PATH": "/path/to/atlas/apps/api",
        "ATLAS_PHP_CONTAINER": "atlas-php",
        "POSTGRES_HOST": "localhost",
        "POSTGRES_PORT": "5432",
        "POSTGRES_DB": "atlas",
        "POSTGRES_USER": "laravel",
        "POSTGRES_PASSWORD": "your-password"
      }
    }
  }
}
