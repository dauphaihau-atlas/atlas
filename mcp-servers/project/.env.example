# Required: Base URL of the Atlas backend API (no trailing slash)
ATLAS_API_URL=http://api.atlas.local/api/v1

# Required: Sanctum bearer token for authentication
ATLAS_API_TOKEN=your-sanctum-token-here

# Optional: Default tenant ID scoped to requests (X-Tenant-ID header).
# Required for user, activity-log, and /me endpoints.
ATLAS_TENANT_ID=
